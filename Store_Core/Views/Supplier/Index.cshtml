@model IEnumerable< Store.Core.Application.DTOs.SupplierDto>
@{
    ViewBag.Title = "Suppliers Management";
}

<div class="container">
    <header>
        <h1>Suppliers Management</h1>
    </header>
    <main>
        <p>
            <a href="@Url.Action("Create", "Supplier")" class="btn btn-primary">Add New Supplier</a>
        </p>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Supplier ID</th>
                    <th>Supplier Name</th>
                    <th>Phone</th>
                   
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td>@supplier.SupplierID</td>
                        <td>@supplier.SupplierName</td>
                        <td>@supplier.Phone</td>
                        <td>
                            <a href="@Url.Action("Edit", "Supplier", new { id = supplier.SupplierID })" class="btn btn-warning">Edit</a>
                              <a href="@Url.Action("Delete", "Supplier", new { id = supplier.SupplierID })" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </main>
</div>
