@model Store.Core.Application.DTOs.SupplierDto

@{
    ViewBag.Title = "Delete Supplier";
}

<div class="container">
    <header>
        <h1>Delete Supplier</h1>
    </header>
    <main>
        <h3>Are you sure you want to delete this supplier?</h3>
        <dl class="dl-horizontal">
            <dt>Supplier Name</dt>
            <dd>@Model.SupplierName</dd>

            <dt>Phone</dt>
            <dd>@Model.Phone</dd>
        </dl>

        @using (Html.BeginForm("Delete", "Supplier", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.SupplierID)
            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@Url.Action("Index", "Supplier")" class="btn btn-secondary">Cancel</a>
        }
    </main>
</div>
