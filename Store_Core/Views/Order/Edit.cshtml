@model Store.Core.Application.DTOs.OrderDto

@{
    ViewBag.Title = "Edit Order";
}

<div class="container">
    <header>
        <h1>Edit Order</h1>
    </header>
    <main>
        @using (Html.BeginForm("Edit", "Order", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.OrderID)

            <div class="form-group">
                <label for="CustomerName">Customer Name</label>
                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Enter Customer Name" })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="OrderDate">Order Date</label>
                @Html.TextBoxFor(m => m.OrderDate, new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.OrderDate, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="Quantity">Quantity</label>
                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", placeholder = "Enter Quantity" })
                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
            </div>



        
            <button type="submit" class="btn btn-primary">Save Changes</button>
        }
    </main>
</div>
