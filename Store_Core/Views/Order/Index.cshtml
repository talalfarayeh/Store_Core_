@model IEnumerable<Store.Core.Application.DTOs.OrderDto>

<div class="container">
    <h1>Orders</h1>
    <a href="@Url.Action("Create", "Order")" class="btn btn-primary">Add New Order</a>
    <table class="table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer Name</th>
                <th>Order Date</th>
                <th>Product Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@order.CustomerName</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.ProductName</td>
                    <td>
                        <a href="@Url.Action("Edit", "Order", new { id = order.OrderID })" class="btn btn-warning">Edit</a>
                        <a href="@Url.Action("Delete", "Order", new { id = order.OrderID })" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
