@model Store_Core.ViewModels.EditProfileViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using Store_Core.Resources
 
@inject IStringLocalizer<SharedResource> Localizer


@{
    ViewData["Title"] = Localizer[SharedResourceKeys.EditProfileTitle];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">@Localizer[SharedResourceKeys.EditProfileTitle]</h2>

           @*  @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @Localizer[SharedResourceKeys.SuccessMessage]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @Localizer[SharedResourceKeys.ErrorMessage]
                </div>
            } *@

            <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                <div class="form-group mb-3">
                    <label asp-for="FullName" class="form-label">@Localizer[SharedResourceKeys.FullName]</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ProfilePicture" class="form-label">@Localizer[SharedResourceKeys.ProfilePicture]</label>
                    <input type="file" name="profilePicture" class="form-control" accept="image/*" />
                    <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <button type="submit" class="btn btn-primary">@Localizer[SharedResourceKeys.SaveChanges]</button>
                </div>
            </form>
        </div>
    </div>
</div>
