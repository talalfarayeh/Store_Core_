@model Store_Core.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<h2>إعادة تعيين كلمة المرور</h2>

<form asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="Email" />

    <div class="form-group">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" class="form-control" type="password" required />
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" required />
    </div>

    <button type="submit" class="btn btn-primary">إعادة تعيين</button>
</form>>