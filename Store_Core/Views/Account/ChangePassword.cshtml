@using Microsoft.Extensions.Localization
@using Store_Core.Resources
@model Store_Core.ViewModels.ChangePasswordViewModel
@inject IStringLocalizer<SharedResource> Localizer

<h2>@Localizer["ChangePassword"]</h2>

<form asp-action="ChangePassword" method="post">
    <div class="form-group">
        <label asp-for="CurrentPassword">@Localizer["CurrentPassword"]</label>
        <input asp-for="CurrentPassword" class="form-control" />
        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NewPassword">@Localizer["NewPassword"]</label>
        <input asp-for="NewPassword" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">@Localizer["ConfirmPassword"]</label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["ChangePassword"]</button>
</form>
