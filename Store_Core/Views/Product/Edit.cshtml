@model Store.Core.Application.DTOs.ProductCreateUpdateDto

@{
    ViewBag.Title = "Edit Product";
}

<h2>Edit Product</h2>
@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.ProductID)
    <div>
        <label>Product Name</label>

        @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Enter Product Name" })
        @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
    </div>
    <div>
        <label>Quantity In Stock</label>
        @Html.TextBoxFor(m => m.QuantityInStock, new { @class = "form-control", placeholder = "Enter Quantity InStock" })
        @Html.ValidationMessageFor(m => m.QuantityInStock, "", new { @class = "text-danger" })
    </div>
    <div>
        <label>Unit Price</label>
        @Html.TextBoxFor(m => m.UnitPrice, new { @class = "form-control", placeholder = "Enter Unit Price" })
        @Html.ValidationMessageFor(m => m.UnitPrice, "", new { @class = "text-danger" })
    </div>
    <div>
        <label>Supplier ID</label>
        @Html.TextBoxFor(m => m.SupplierID, new { @class = "form-control", placeholder = "Enter Supplier ID" })
        @Html.ValidationMessageFor(m => m.SupplierID, "", new { @class = "text-danger" })
    </div>
    <button type="submit">Save Changes</button>
}
